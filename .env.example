# Variables de infraestructura que consume docker-compose (servicios base).
# La configuración de la app Django vive en backend/.env (ver backend/.env.example).
# Copiar a .env y reemplazar los valores por secretos reales (nunca commitear .env).

# ─── POSTGRES ────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=nutrilius
POSTGRES_USER=nutrilius_user
POSTGRES_PASSWORD=change_me

# ─── REDIS ───────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me

# ─── RABBITMQ ────────────────────────────────────────────
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=nutrilius
RABBITMQ_PASSWORD=change_me
RABBITMQ_VHOST=/

# ─── MINIO ───────────────────────────────────────────────
MINIO_ACCESS_KEY=nutrilius
MINIO_SECRET_KEY=change_me
