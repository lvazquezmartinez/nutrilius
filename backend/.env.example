# ─── Django ──────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change_me_min_50_chars_para_produccion
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
TZ=America/Argentina/Buenos_Aires

# ─── PostgreSQL ──────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=nutrilius
POSTGRES_USER=nutrilius_user
POSTGRES_PASSWORD=change_me

# ─── Redis / Celery ──────────────────────────────────────
REDIS_URL=redis://:change_me@redis:6379/0
CELERY_BROKER_URL=redis://:change_me@redis:6379/0
CELERY_RESULT_BACKEND=redis://:change_me@redis:6379/0

# ─── Storage S3-compatible (MinIO en dev / GCS en prod) ──
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=nutrilius
S3_SECRET_KEY=change_me
S3_BUCKET=nutrilius
S3_REGION=

# ─── IA (Fase 4) ─────────────────────────────────────────
AI_PROVIDER=openrouter
AI_API_KEY=change_me
AI_MODEL=openai/gpt-4o

# ─── SMTP (Fase 1) ───────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=change_me
SMTP_PASSWORD=change_me
SMTP_FROM=no-reply@nutrilius.com.ar
